rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /orders/{orderId} {

      allow read: if request.auth != null &&
                   request.auth.token.email.matches(".*@snu\\.edu\\.in$");

      // contact must be a bare 10-digit Indian mobile (starts 6-9). The form
      // normalizes "+91 98765 43210" etc. down to this before writing, so
      // anything else here means the UI was bypassed.
      allow create: if request.auth != null &&
                     request.auth.token.email.matches(".*@snu\\.edu\\.in$") &&
                     request.resource.data.contact is string &&
                     request.resource.data.contact.matches("^[6-9][0-9]{9}$");

      allow update, delete:
        if request.auth != null &&
           resource.data.posterId == request.auth.uid;

      match /joins/{joinerId} {
        allow create: if request.auth != null &&
                       request.auth.token.email.matches(".*@snu\\.edu\\.in$") &&
                       request.auth.uid == joinerId;

        allow read: if request.auth != null &&
                     request.auth.token.email.matches(".*@snu\\.edu\\.in$") &&
                     (request.auth.uid == joinerId ||
                      get(/databases/$(database)/documents/orders/$(orderId)).data.posterId == request.auth.uid);
      }
    }
  }
}